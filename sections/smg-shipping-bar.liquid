<div class="smg-shipping-bar">
  <div class="smg-container">
    {{ section.settings.text }}
  </div>
</div>

{% schema %}
{
  "name": "Shipping message",
  "class": "smg-shipping-bar-section",
  "settings": [
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Free shipping Australia wide with every book order over $50!*</p><p><em>* Some items excluded, these are clearly marked in the item's description</em></p>"
    }
  ],
  "presets": [{ "name": "Shipping message" }]
}
{% endschema %}
