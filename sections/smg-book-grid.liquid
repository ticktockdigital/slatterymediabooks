{%- liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = section.settings.collection.title | default: collection.title
  endif
-%}

<div
  class="smg-book-grid"
  {% if section.settings.anchor != blank %}id="{{ section.settings.anchor | handleize }}"{% endif %}
  style="--smg-columns: {{ section.settings.columns }}; --smg-columns-mobile: {{ section.settings.columns_mobile }};"
>
  <div class="smg-container">
    {%- if heading != blank -%}
      <h3 class="smg-heading">{{ heading }}</h3>
    {%- endif -%}

    {%- comment -%} paginate only accepts the drop directly, not an assigned variable {%- endcomment -%}
    {%- if section.settings.collection != blank -%}
      {%- paginate section.settings.collection.products by section.settings.limit -%}
        {% render 'smg-book-list',
          products: section.settings.collection.products,
          paginate: paginate,
          show_pagination: section.settings.paginate
        %}
      {%- endpaginate -%}
    {%- elsif collection -%}
      {%- paginate collection.products by section.settings.limit -%}
        {% render 'smg-book-list',
          products: collection.products,
          paginate: paginate,
          show_pagination: section.settings.paginate
        %}
      {%- endpaginate -%}
    {%- elsif request.design_mode -%}
      <ul class="smg-book-grid__list">
        {%- for i in (1..6) -%}
          <li>
            <div class="smg-book">
              <div class="smg-book__cover">{{ 'product-1' | placeholder_svg_tag }}</div>
              <h4 class="smg-book__title">Book title</h4>
              <div class="smg-price-bar"><span>$00.00</span><span>Add to cart</span></div>
            </div>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Book grid",
  "class": "smg-book-grid-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank to use the collection title"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Leave blank on collection pages to show the current collection"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor ID",
      "info": "Lets menu links jump to this section, e.g. /#sale"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Books to show",
      "min": 6,
      "max": 48,
      "step": 6,
      "default": 48
    },
    {
      "type": "checkbox",
      "id": "paginate",
      "label": "Show pagination",
      "default": false
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns on desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 6
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    }
  ],
  "presets": [{ "name": "Book grid" }]
}
{% endschema %}
