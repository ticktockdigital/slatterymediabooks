{%- liquid
  assign show = true
  if section.settings.home_only and request.page_type != 'index'
    assign show = false
  endif
  if request.page_type == 'cart'
    assign show = false
  endif
-%}

{%- if show and section.blocks.size > 0 -%}
  <smg-banner
    class="smg-banner"
    data-interval="{{ section.settings.interval }}"
    style="--smg-banner-height: {{ section.settings.height }}px; --smg-banner-height-mobile: {{ section.settings.height_mobile }}px;"
    {{ section.shopify_attributes }}
  >
    {%- for block in section.blocks -%}
      <div class="smg-banner__slide{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
        {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{%- endif -%}
        {%- if block.settings.image != blank -%}
          {%- assign alt = block.settings.image.alt | default: block.settings.alt -%}
          {%- if forloop.first -%}
            {{ block.settings.image | image_url: width: 3000 | image_tag: widths: '750, 1100, 1500, 2200, 3000', sizes: '100vw', alt: alt, fetchpriority: 'high' }}
          {%- else -%}
            {{ block.settings.image | image_url: width: 3000 | image_tag: widths: '750, 1100, 1500, 2200, 3000', sizes: '100vw', alt: alt, loading: 'lazy' }}
          {%- endif -%}
        {%- else -%}
          {{ 'hero-apparel-1' | placeholder_svg_tag }}
        {%- endif -%}
        {%- if block.settings.link != blank -%}</a>{%- endif -%}
      </div>
    {%- endfor -%}
  </smg-banner>
{%- endif -%}

{% schema %}
{
  "name": "Banner",
  "class": "smg-banner-section",
  "max_blocks": 10,
  "settings": [
    {
      "type": "checkbox",
      "id": "home_only",
      "label": "Only show on homepage",
      "default": false
    },
    {
      "type": "range",
      "id": "height",
      "label": "Desktop height",
      "min": 200,
      "max": 700,
      "step": 10,
      "unit": "px",
      "default": 450
    },
    {
      "type": "range",
      "id": "height_mobile",
      "label": "Mobile height",
      "min": 100,
      "max": 500,
      "step": 10,
      "unit": "px",
      "default": 200
    },
    {
      "type": "range",
      "id": "interval",
      "label": "Seconds per slide",
      "min": 3,
      "max": 20,
      "step": 1,
      "unit": "s",
      "default": 10
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image", "info": "1500 x 450px recommended" },
        { "type": "text", "id": "alt", "label": "Alt text (if image has none)" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Banner",
      "blocks": [{ "type": "slide" }]
    }
  ]
}
{% endschema %}
