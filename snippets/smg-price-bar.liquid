{%- doc -%}
  Renders the green-ruled price and "Add to cart" bar used on book cards and the product page.

  @param {product} product - The product
{%- enddoc -%}
{%- assign variant = product.selected_or_first_available_variant -%}
<div class="smg-price-bar">
  <span class="smg-price-bar__price">{{ variant.price | money }}</span>
  {%- if variant.available -%}
    <form method="post" action="{{ routes.cart_add_url }}" data-smg-buy>
      <input type="hidden" name="id" value="{{ variant.id }}">
      <input type="hidden" name="quantity" value="1">
      <button type="submit" class="smg-price-bar__buy">Add to cart</button>
    </form>
  {%- else -%}
    <span class="smg-price-bar__buy">Sold out</span>
  {%- endif -%}
  {%- if variant.compare_at_price > variant.price -%}
    <span class="smg-price-bar__was">Was {{ variant.compare_at_price | money }}</span>
  {%- endif -%}
</div>
